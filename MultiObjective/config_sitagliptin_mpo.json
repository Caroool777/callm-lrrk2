{
    "task_name": "sitagliptin_mpo",
    "task_description": "Sitagliptin 多属性优化 (Multi-Property Objective)",
    
    "seed": 42,
    "max_oracle_calls": 10000,
    "pop_size": 100,
    "crossover_rate": 0.8,
    "mutation_rate": 0.5,
    
    "initial_smiles_file": "../250k_rndm_zinc_drugs_clean_3.csv",
    
    "biot5_num_beams": 5,
    "biot5_num_return_sequences": 3,
    "biot5_temperature": 0.8,
    "biot5_do_sample": true,
    "biot5_elite_count": 10,
    
    "belief_capacity": 100,
    "scaffold_threshold": 0.3,
    "min_scaffold_samples": 2,
    
    "use_scaffold_constraint": true,
    
    "objectives": {
        "similarity": {
            "description": "与 Sitagliptin 的 Tanimoto 相似度",
            "weight": 1.0,
            "target": "maximize"
        },
        "tpsa": {
            "description": "拓扑极性表面积 (TPSA)",
            "weight": 1.0,
            "target_range": [80, 100]
        },
        "logp": {
            "description": "脂水分配系数 (LogP)",
            "weight": 1.0,
            "target_range": [1, 3]
        },
        "fluorine": {
            "description": "氟原子数量",
            "weight": 1.0,
            "target_range": [2, 3]
        }
    },
    
    "output_dir": "../MultiResult/sitagliptin_mpo_results",
    
    "comments": [
        "Sitagliptin (西格列汀) 是一种 DPP-4 抑制剂，用于治疗 2 型糖尿病",
        "此任务基于 GuacaMol Benchmark 的 MPO 任务",
        "多目标优化使用帕累托支配关系进行选择"
    ]
}
